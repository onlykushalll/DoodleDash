// Doodle Dash schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlayerStat {
  id        String   @id @default(cuid())
  name      String   @unique
  avatar    String   @default("🐱")
  color     String   @default("#ff7a59")
  wins      Int      @default(0)
  games     Int      @default(0)
  bestScore Int      @default(0)
  totalScore Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bestScore])
  @@index([totalScore])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  roomCode     String
  name         String
  avatar       String
  color        String
  customAvatar String?
  isSpectator  Boolean  @default(false)
  score        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime

  @@index([roomCode, name])
  @@index([sessionToken])
}
